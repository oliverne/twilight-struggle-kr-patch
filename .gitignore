# 원본 백업 (용량 큼, 로컬 전용)
original/

# 도구 바이너리 (UABEA, legacy 패치 등) — README는 관리
tools/uabea/
tools/legacy-patches/
tools/asset-ripper/

# Python
.venv/
__pycache__/
*.pyc

# .NET 빌드 산출물 (asset-tool)
tools/asset-tool/bin/
tools/asset-tool/obj/

# 폰트 생성 산출물 중 대형 아틀라스 (필요 시 git-lfs로 전환)
fonts/**/*.png
!fonts/.gitkeep

# OS
.DS_Store

# 패치 결과물 중 대형 에셋 (재생성 가능, GitHub 100MB 제한 초과)
patched/*.assets

# 배포 zip 산출물 (scripts/package-release.sh 생성, GitHub Releases로 업로드)
dist/

# Windows 폰트 주입 작업 폴더 (가상 게임 폴더 + 테스트 산출물)
tools/font-inject-work/
tools/unity-font-replacer/*.json
tools/unity-font-replacer/verbose.txt

# 게임 텍스트 덤프 (게임 파생물, 로컬 전용)
tools/dump/
tools/dump-legacy-v1.0.1/
tools/dump-legacy-v2.0.1/
tools/unity-font-replacer/src/
tools/unity-font-replacer/*.exe
tools/unity-font-replacer/Il2CppDumper/
tools/unity-font-replacer/KR_ASSETS/
fonts/*.ttf
*.zip
황혼의투쟁_한국어패치_20260315/
