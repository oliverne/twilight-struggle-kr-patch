---
interface Props {
  label: string;
  sub?: string;
  ring?: string;
  rotate?: string;
}
const { label, sub, ring = '· DECLASSIFIED · TS-KR · 2026 ·', rotate = '-6deg' } = Astro.props;
const uid = `ring-${label.replace(/\s/g, '')}`;
---
<div class="stamp-round" style={`rotate:${rotate}`} aria-hidden="true">
  <svg class="stamp-svg" viewBox="0 0 200 200" focusable="false">
    <defs>
      <path id={uid} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" fill="none" />
    </defs>
    <text class="stamp-ring-text">
      <textPath href={`#${uid}`} startOffset="0">
        {ring}
      </textPath>
    </text>
  </svg>
  <span class="stamp-inner">
    <b>{label}</b>
    {sub && <span>{sub}</span>}
  </span>
</div>

<style>
  .stamp-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stamp-ring-text {
    font-family: var(--ff-mono);
    font-size: 13.5px;
    letter-spacing: 2.5px;
    fill: currentColor;
    text-transform: uppercase;
  }
</style>
