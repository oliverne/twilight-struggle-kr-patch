---
interface Props {
  n: number;
  caption?: string;
}
const { n, caption } = Astro.props;
---
<!--
  스크린샷 슬롯 — 실제 이미지로 교체:
  1. website/public/img/shots/1.png (16:9, ~1600x900 권장) 생성
  2. 아래 <figure>를 <figure class="shot"><img src="/twilight-struggle-kr-patch/img/shots/1.png" alt="..."></figure>로 교체
  (alt는 실제 화면 내용으로)
-->
<figure class="shot" data-reveal>
  <div class="shot-plate">
    <div class="shot-note" aria-hidden="true">
      <span class="lbl">사진 자료 미첨부</span>
      <span class="sub">16:9 · 슬롯 {n} · 교체 예정</span>
    </div>
    <span class="stamp-mini" aria-hidden="true">미첨부</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
