---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const RELEASE = "v0.1.2";
const GH = "https://github.com/oliverne/twilight-struggle-kr-patch";
const DL = `${GH}/releases/download/${RELEASE}`;
const F = (os: string) => `twilight-struggle-kr-patch-${RELEASE}-${os}.zip`;

// 도트 세계지도 마스크 — 서반구(미주=파랑) / 동반구(구대륙=빨강)
// 절대 경로('/') 대신 base를 붙여야 GitHub Pages 프로젝트 경로에서도 불러온다.
const maskStyle = (file: string) =>
  `-webkit-mask-image:url('${base}img/${file}');mask-image:url('${base}img/${file}');-webkit-mask-size:cover;mask-size:cover;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;`;

const osList = [
  {
    id: "windows",
    name: "윈도우",
    desc: "Windows 10 / 11",
    file: F("windows"),
    size: "8.9MB",
    url: `${DL}/${F("windows")}`,
    cmd: "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-windows.ps1",
    cmdNote: "압축을 푼 폴더에서 PowerShell을 열고 설치 스크립트 실행",
  },
  {
    id: "macos",
    name: "macOS",
    desc: "최근 macOS 버전",
    file: F("macos"),
    size: "9.4MB",
    url: `${DL}/${F("macos")}`,
    cmd: "chmod +x scripts/install.sh && ./scripts/install.sh",
    cmdNote: "압축을 푼 폴더에서 터미널을 열고 설치 스크립트 실행",
  },
] as const;

const fieldNotes = [
  {
    mark: "적용 범위",
    title: "패치 후에도 영어로 나오는 문구가 있습니다. 어떻게 된 거예요?!",
    detail:
      "턴 히스토리와 튜토리얼 안내, 그리고 일부 진행 메시지는 직접 패치하기 어려운 구조라 영어로 표시됩니다. 한식구 카페 패치는 방식이 달라 그 부분이 한국어로 나올지도 몰라요",
  },
  {
    mark: "호환 버전",
    title: "이 패치는 어떤 게임 버전에서 사용할 수 있나요?",
    detail:
      "게임 버전 1.4.11.167에서 확인했습니다. 게임 업데이트가 있으면 패치를 다시 만들어야 하지만, 몇 년째 업데이트가 없어 당분간은 괜찮을 것 같아요.",
  },
  {
    mark: "검증 결과",
    title: "검수는 똑바로 했나요? 멀티플레이는 제대로 되나요?",
    detail:
      "라이트 게이머라 내용이 틀려도 잘 몰라요. 또한, 친구가 없어 멀티플레이는 못 해 봤습니다. (AI로) 어색한 번역투, 틀린 조사 및 오타를 일부 수정했습니다.",
  },
  {
    mark: "지원 범위",
    title:
      "안드로이드나 iOS(아이폰, 아이패드)에서도 한글 패치가 되나요? 스팀덱은 되나요?",
    detail:
      "아니요, 아쉽지만 안드로이드와 iOS에서는 안 됩니다. (AI가) 스팀덱에서는 동작할 거라고는 하는데, 제가 스팀덱이 없어 테스트는 못 해 봤습니다.",
  },
  {
    mark: "수동 설치",
    title: "뭘 믿고 스크립트를 실행하나요? 수동으로 설치할 수 없나요?",
    detail:
      "다운로드한 파일의 압축을 풀고, 패치 파일을 직접 게임 설치 폴더에 덮어쓰면 됩니다. 복원할 때는 게임을 삭제한 후 재설치하거나 Steam 무결성 검사를 이용하세요. macOS에서 패치를 수동으로 복사할 경우 실행 오류가 발생할 수 있습니다. 이때는 직접 code signing을 하시거나, 설치 스크립트를 이용하세요.",
  },
  {
    mark: "만든 이유",
    title: "한글 패치를 굳이? 또? 왜? 만들었나요?",
    detail:
      "오랜만에 게임 좀 해 보고 싶었습니다만, 블루문(우드킹)님 패치가 게임 업데이트로 지원이 끊겼길래 '그럼 AI로 직접 고치면 되지 않을까?' 하고 시작했는데, AI가 한식구 네이버 카페의 최신 패치를 찾아 주었습니다. 하지만, BepInEx 방식 패치는 macOS에서 사용할 수 없어 직접... 아니, AI를 시켜 고쳐 봤습니다.",
  },
] as const;

const screenshots = [
  {
    file: "ts-kr-1",
    alt: "한국어로 표시된 Twilight Struggle 메인 메뉴",
  },
  {
    file: "ts-kr-2",
    alt: "한국어 카드 설명이 열린 Twilight Struggle 게임 보드",
  },
  {
    file: "ts-kr-3",
    alt: "한국어로 표시된 Twilight Struggle 작전 결과 화면",
  },
] as const;
---

<Base
  title="Twilight Struggle 한국어 패치 · Steam판을 한국어로"
  description="Steam판 Twilight Struggle의 비공식 한국어 패치. 카드·메뉴·인게임 UI·규칙북·도움말을 한국어로. 무료 다운로드, 설치하면 바로 한글."
>
  <!-- ══ 히어로 — 1970년대 정보기관 사건 파일 표지 ══ -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="dossier-map" aria-hidden="true">
      <i class="west" style={maskStyle("world-mask-west.png")}></i>
      <i class="east" style={maskStyle("world-mask-east.png")}></i>
    </div>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="cover-meta" aria-hidden="true">
        <span><b>CASE NO.</b> TS-KR-406290</span>
        <span><b>DATE RELEASED</b> 2026.08</span>
        <span><b>DISTRIBUTION</b> STEAM DESKTOP</span>
        <span class="cover-status">DECLASSIFIED</span>
      </div>

      <div class="hero-main">
        <div class="hero-copy">
          <h1 class="hero-title" id="hero-title">
            <span class="mask-line brand-line" style="--i: 0">
              <span
                class="mask-line-inner logo-wordmark"
                role="img"
                aria-label="Twilight Struggle, 황혼의 투쟁"
              >
                <span class="logo-english" aria-hidden="true">
                  <span class="logo-twilight">Twilight</span><span
                    class="logo-struggle">Struggle</span
                  >
                </span>
                <span class="logo-ink" aria-hidden="true"></span>
                <span class="logo-korean" aria-hidden="true">
                  <span class="logo-korean-twilight">황혼의</span><span
                    class="logo-korean-struggle">투쟁</span
                  >
                </span>
              </span>
            </span>
            <span class="mask-line patch-line" style="--i: 1">
              <span class="mask-line-inner patch-lockup"
                >한국어 패치 {RELEASE}</span
              >
            </span>
          </h1>

          <p class="hero-summary">
            디지털 보드게임 Twilight Struggle의 Steam 버전 한국어 패치입니다.
            윈도우와 macOS를 지원합니다.
          </p>

          <div class="hero-actions">
            <a class="stamp-btn" href="#download">
              <svg
                class="glyph"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
                ><path d="M8 2v9M4 7.5 8 11.5 12 7.5"></path></svg
              >
              다운로드
            </a>
          </div>
        </div>

        <div
          class="hero-carousel"
          role="region"
          aria-roledescription="캐러셀"
          aria-label="한글 패치 적용 화면"
          tabindex="0"
          data-carousel
        >
          <div class="carousel-viewport">
            {
              screenshots.map((screenshot, index) => (
                <figure
                  class="carousel-slide"
                  role="group"
                  aria-roledescription="슬라이드"
                  aria-label={`${index + 1} / ${screenshots.length}`}
                  data-carousel-slide
                  hidden={index !== 0}
                >
                  <a
                    href={`${base}img/${screenshot.file}.jpg`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${screenshot.alt}, 원본 이미지 새 탭에서 보기`}
                  >
                    <picture>
                      <source
                        srcset={`${base}img/${screenshot.file}.webp`}
                        type="image/webp"
                      />
                      <img
                        src={`${base}img/${screenshot.file}.jpg`}
                        width="3024"
                        height="1964"
                        alt={screenshot.alt}
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                      />
                    </picture>
                  </a>
                </figure>
              ))
            }
          </div>
          <div class="carousel-footer">
            <span>macOS · 패치 적용 화면</span>
            <div class="carousel-controls">
              <button type="button" data-carousel-prev aria-label="이전 화면">
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  ><path d="m10 3-5 5 5 5"></path></svg
                >
              </button>
              <span class="carousel-count" aria-live="polite" aria-atomic="true">
                <b data-carousel-current>01</b> / {String(screenshots.length).padStart(2, "0")}
              </span>
              <button type="button" data-carousel-next aria-label="다음 화면">
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  ><path d="m6 3 5 5-5 5"></path></svg
                >
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="cover-approval" aria-hidden="true">
        <span>TRANSLATION FILE</span>
        <b>REVIEWED COPY</b>
      </div>
    </div>
  </section>

  <div class="sheets">
    <div class="board-chart board-chart--north" aria-hidden="true">
      <i class="west" style={maskStyle("world-mask-west.png")}></i>
      <i class="east" style={maskStyle("world-mask-east.png")}></i>
    </div>
    <div class="board-chart board-chart--south" aria-hidden="true">
      <i class="west" style={maskStyle("world-mask-west.png")}></i>
      <i class="east" style={maskStyle("world-mask-east.png")}></i>
    </div>
    <!-- ══ 다운로드 · 설치 · 알아두면 좋은 점 — 한 장의 서류 ══ -->
    <section class="sheet" id="download" aria-labelledby="dl-h">
      <span class="envelope-seams" aria-hidden="true"></span>
      <div class="container sheet-grid">
        <div class="document-meta" aria-hidden="true">
          <span>FILE TS-KR-406290 · RELEASE {RELEASE}</span>
          <span class="document-status">DECLASSIFIED COPY</span>
        </div>
        <div class="download-zone case-contents">
          <div class="download-block document-section">
            <header class="section-head">
              <span aria-hidden="true">배포 승인 01</span>
              <div>
                <h2 id="dl-h">패치 파일 받기</h2>
                <p class="download-lead">
                  게임이 설치된 컴퓨터의 운영체제를 선택하세요.
                </p>
              </div>
            </header>

            <div
              class="dl-tabs"
              id="os-picker"
              role="tablist"
              aria-label="운영체제 선택"
            >
              {
                osList.map((os) => (
                  <button
                    type="button"
                    id={`tab-${os.id}`}
                    class:list={["dl-tab", { active: os.id === "windows" }]}
                    data-os={os.id}
                    role="tab"
                    aria-controls={`dl-${os.id}`}
                    aria-selected={os.id === "windows" ? "true" : "false"}
                    tabindex={os.id === "windows" ? 0 : -1}
                  >
                    {os.name}
                  </button>
                ))
              }
            </div>

            {
              osList.map((os) => (
                <div
                  class:list={["dl-panel", { on: os.id === "windows" }]}
                  data-os={os.id}
                  id={`dl-${os.id}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${os.id}`}
                  hidden={os.id !== "windows"}
                >
                  <div class="dl-heading">
                    <strong>{os.name}용 패치</strong>
                    <span>{os.desc}</span>
                  </div>
                  <p class="dl-meta">
                    <b class="dl-file">{os.file}</b>
                    <span class="dl-sub">{os.size}</span>
                  </p>
                  <a
                    class="stamp-btn"
                    href={os.url}
                    download
                    aria-label={`${os.name}용 한글 패치 ${RELEASE} 다운로드`}
                  >
                    <svg
                      class="glyph"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                    >
                      <path d="M8 2v9M4 7.5 8 11.5 12 7.5" />
                    </svg>
                    {os.name}용 다운로드
                  </a>
                  <div class="file-note">
                    파일을 직접 확인하려면{" "}
                    <a href={`${GH}/releases/tag/${RELEASE}`}>
                      {RELEASE} 릴리스 페이지
                    </a>
                    를 이용하세요.
                  </div>
                </div>
              ))
            }
          </div>

          <section
            class="filebox document-section"
            id="install"
            aria-labelledby="install-h"
          >
            <header class="section-head section-head--dark">
              <span aria-hidden="true">실행 절차 02</span>
              <div>
                <h2 id="install-h" class="box-title">패치 설치하기</h2>
                <p>게임 설치 폴더 확인 · 원본 자동 백업 · 제거 스크립트 포함</p>
              </div>
            </header>

            <ol class="steps">
              <li class="step">
                <span class="num" aria-hidden="true">01</span>
                <div>
                  <h3>게임 종료 · 압축 해제</h3>
                  <p>
                    게임을 완전히 종료하고, 받은 zip 파일을 아무 폴더에나
                    압축을 풉니다.
                  </p>
                </div>
              </li>
              <li class="step">
                <span class="num" aria-hidden="true">02</span>
                <div>
                  {
                    osList.map((os) => (
                      <>
                        <h3
                          data-os={os.id}
                          data-cmdnote
                          hidden={os.id !== "windows"}
                        >
                          {os.cmdNote}
                        </h3>
                        <p
                          class="cmd"
                          data-os={os.id}
                          data-cmd
                          hidden={os.id !== "windows"}
                        >
                          <code>{os.cmd}</code>
                          <button
                            type="button"
                            class="copy"
                            data-copy={os.cmd}
                            aria-live="polite"
                          >
                            복사
                          </button>
                        </p>
                      </>
                    ))
                  }
                  <p class="cmd-note">수동 설치 방법은 아래 자주 묻는 질문에서 확인할 수 있습니다.</p>
                </div>
              </li>
              <li class="step">
                <span class="num" aria-hidden="true">03</span>
                <div>
                  <h3>게임 실행</h3>
                  <p>
                    Steam에서 게임을 시작하면 한글로 표시됩니다. (게임에 언어 선택 메뉴가 없어 영어를 한국어로 대체합니다.)
                  </p>
                </div>
              </li>
            </ol>
          </section>

          <section
            class="notes-block document-section"
            id="faq"
            aria-labelledby="notes-h"
          >
            <header class="section-head">
              <span aria-hidden="true">현장 기록 03</span>
              <div>
                <h2 id="notes-h">자주 묻는(?) 질문</h2>
                <p class="lead"></p>
              </div>
            </header>
            <div class="notes">
              {
                fieldNotes.map((item) => (
                  <div class="note">
                    <p class="note-q">
                      <span class="note-mark">{item.mark}</span>
                      {item.title}
                    </p>
                    <p class="note-a">
                      {item.detail}
                      {"href" in item && (
                        <>
                          <br />
                          <a href={item.href}>{item.linkLabel}</a>
                        </>
                      )}
                    </p>
                  </div>
                ))
              }
            </div>
          </section>
        </div>
      </div>
    </section>
  </div>

  <!-- ══ 기록 및 권리 정보 ══ -->
  <footer slot="footer" class="site-foot" aria-labelledby="foot-h">
    <div class="container">
      <div class="foot-head">
        <h2 id="foot-h" class="foot-title">기록 및 권리 정보</h2>
        <span>ARCHIVE REGISTER · TS-KR-406290</span>
      </div>
      <div class="foot-register">
        <section>
          <h3>바로 가기</h3>
          <p class="foot-links">
            <a href={`${GH}`}>GitHub 저장소</a><a
              href={`${GH}/releases/tag/${RELEASE}`}>릴리스 {RELEASE}</a
            ><a href={`${GH}/issues`}>오류 제보</a>
          </p>
        </section>
        <section>
          <h3>번역 출처</h3>
          <p>
            <a href="https://cafe.naver.com/hansicgu/32259"
              >네이버 카페 한식구 짜짜님 패치</a
            >(2026-03-15)의 번역을 재사용하고, <a
              href="https://bluechip2022.tistory.com/2"
              >블루칩(+우드킹)님 한글 패치</a
            >를 참고·검증했습니다. 기존 제작자분께 감사드립니다.
          </p>
          <p>일부 오타, 번역투, 한국어 조사 오류 등을 AI로 수정했습니다.</p>
        </section>
        <section>
          <h3>라이선스</h3>
          <p>
            이 코드와 문서는 MIT 라이선스이지만, 번역문은 원저작자 정책을
            따릅니다.
          </p>
          <p>
            이 한국어 패치는 비공식 팬 패치입니다. GMT Games, Playdek, Valve와
            무관하며, 게임과 에셋의 저작권은 각 권리자에게 있습니다.
          </p>
        </section>
      </div>
      <div class="foot-credits">
        <p class="fine">
          본문 폰트: YKompyuta · 헤드라인 폰트: Oswald/Paperlogy · 세계 지도:
          Wikimedia Commons
        </p>
        <p class="fine">마지막 수정: 2026년 8월 중순</p>
      </div>
    </div>
  </footer>
</Base>

<script>
  // OS 탭 → 다운로드 패널·설치 명령 연동
  const tabList = document.getElementById("os-picker");
  const tabs = Array.from(tabList?.querySelectorAll(".dl-tab") ?? []);
  const panels = document.querySelectorAll(".dl-panel");
  const cmds = document.querySelectorAll("[data-cmd]");
  const cmdnotes = document.querySelectorAll("[data-cmdnote]");

  const applyOs = (id) => {
    panels.forEach((p) => {
      const active = p.dataset.os === id;
      p.classList.toggle("on", active);
      p.hidden = !active;
    });
    tabs.forEach((t) => {
      const active = t.dataset.os === id;
      t.classList.toggle("active", active);
      t.setAttribute("aria-selected", active ? "true" : "false");
      t.tabIndex = active ? 0 : -1;
    });
    cmds.forEach((c) => (c.hidden = c.dataset.os !== id));
    cmdnotes.forEach((c) => (c.hidden = c.dataset.os !== id));
  };

  // 자동 추천: macOS 감지 시 macOS, 그 외는 Windows
  const nav = navigator.userAgent;
  const suggested = /Mac|iPhone|iPad/.test(nav) ? "macos" : "windows";
  applyOs(suggested);

  tabs.forEach((t) => t.addEventListener("click", () => applyOs(t.dataset.os)));
  // 키보드: 좌/우 화살표로 탭 이동
  tabList?.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    e.preventDefault();
    const cur = tabs.findIndex((t) => t.classList.contains("active"));
    if (cur < 0) return;
    const next =
      e.key === "ArrowRight"
        ? (cur + 1) % tabs.length
        : (cur - 1 + tabs.length) % tabs.length;
    tabs[next].focus();
    applyOs(tabs[next].dataset.os);
  });

  // 패치 적용 화면 — 첫 장은 무작위로 고르고 이후에는 사용자가 직접 넘긴다.
  const carousel = document.querySelector("[data-carousel]");
  const slides = Array.from(
    carousel?.querySelectorAll("[data-carousel-slide]") ?? [],
  );
  const current = carousel?.querySelector("[data-carousel-current]");
  let activeSlide = slides.length > 0
    ? Math.floor(Math.random() * slides.length)
    : 0;

  const showSlide = (next) => {
    activeSlide = (next + slides.length) % slides.length;
    slides.forEach((slide, index) => {
      slide.hidden = index !== activeSlide;
    });
    if (current) current.textContent = String(activeSlide + 1).padStart(2, "0");
  };

  if (slides.length > 0) showSlide(activeSlide);

  carousel
    ?.querySelector("[data-carousel-prev]")
    ?.addEventListener("click", () => showSlide(activeSlide - 1));
  carousel
    ?.querySelector("[data-carousel-next]")
    ?.addEventListener("click", () => showSlide(activeSlide + 1));
  carousel?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    event.preventDefault();
    showSlide(activeSlide + (event.key === "ArrowRight" ? 1 : -1));
  });

  // 히어로는 이미 해제된 기록물로 고정한다. 실시간 추적·레이더 효과는 사용하지 않는다.
</script>
