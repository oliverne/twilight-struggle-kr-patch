# 원본 백업 (용량 큼, 로컬 전용)
original/

# 도구 바이너리 (UABEA, legacy 패치 등) — README는 관리
tools/uabea/
tools/legacy-patches/
tools/asset-ripper/

# Python
.venv/
__pycache__/
*.pyc

# .NET 빌드 산출물 (asset-tool)
